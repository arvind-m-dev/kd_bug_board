DATABASE_URL=
BUGFLOW_ADMIN_EMAIL=
BUGFLOW_ADMIN_PASSWORD=
BUGFLOW_PORTAL_ENCRYPTION_KEY=

# Live site address (recommended), e.g. https://bugs.example.com. Links copied on a local dev server use it,
# so colleagues never receive localhost links. Also used for social preview images.
VITE_SITE_URL=

# Optional: AI welcome drafts (defaults to Google Gemini)
AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-5-mini

# Optional: private media uploads in an S3-compatible bucket (Cloudflare R2 free tier recommended; Settings → Media storage has the guide)
# Default media bucket (optional). Admin can also connect their own bucket from Settings → Media storage; that needs BUGFLOW_PORTAL_ENCRYPTION_KEY.
MEDIA_S3_ENDPOINT=
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_S3_REGION=auto
# MEDIA_S3_FORCE_PATH_STYLE=1

# Optional: Jira Cloud connection (Settings → Jira). One Atlassian OAuth 2.0 (3LO) app owned by this workspace.
# Needs migration database/027_jira_sync.sql. Connecting alone synchronizes nothing.
# JIRA_CLIENT_ID=
# JIRA_CLIENT_SECRET=
# Only for Jira tokens, 32 random bytes as hex: openssl rand -hex 32
# JIRA_TOKEN_ENCRYPTION_KEY=
# Public https address of this app; Atlassian returns the browser to <address>/api/integrations/jira/callback.
# Defaults to SITE_URL or the Vercel production domain.
# JIRA_PUBLIC_ORIGIN=
# Recommended while testing: the only Jira site that may be connected, e.g. https://yourname.atlassian.net
# JIRA_ALLOWED_SITE_URL=
# Secret for the sync job endpoints (POST /api/internal/jira/process and /api/internal/jira/reconcile, header
# "Authorization: Bearer <secret>"). A scheduler calls them; locally: scripts/jira-sync-loop.mjs.
# At least 32 characters: openssl rand -hex 32. Without it the endpoint stays closed.
# JIRA_JOB_SECRET=

# Local trial behind an HTTPS tunnel only: believe the tunnel's X-Forwarded-Proto so sign-in and saves pass the
# same-origin check. Leave unset everywhere else (Vercel already serves https).
# BUGFLOW_TRUST_PROXY=1

# Local only: set to 1 if your network cannot resolve the Neon hostname
# DATABASE_DOH=1


# TEMPORARY: 1 shows a "Login without credentials" link under Sign in on /login that signs anyone in as Admin without a password. Remove when done.
# BUGFLOW_DEMO_LOGIN=1
